# ============================================================
# BIS SmartAssist - Backend Environment Configuration Example
# Copy this file to .env and adjust values as needed.
# ============================================================

# Ollama LLM Configuration
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT=60

# FastAPI Host & Port
API_HOST=127.0.0.1
API_PORT=8000

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Document Upload Limits
MAX_FILE_SIZE_MB=10
MAX_FILES_COUNT=5
TESSERACT_CMD=
TESSDATA_PREFIX=

# Optional Custom Tesseract Path (e.g. C:\Program Files\Tesseract-OCR\tesseract.exe)
# TESSERACT_CMD=

